Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 27; 37; 48
    Fixed Frame: estate
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Surveyed estate (prior)
      Enabled: true
      Value: true
      Topic:
        Value: /twin/estate
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: Observed occupancy (LiDAR only)
      Enabled: true
      Value: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: false
      Topic:
        Value: /twin/observed_map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: Husky estimated pose
      Enabled: true
      Value: true
      Topic:
        Value: /twin/husky/model
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Marker
      Name: Observed laser returns
      Enabled: true
      Value: true
      Topic:
        Value: /twin/husky/returns
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Marker
      Name: Position uncertainty (2 sigma)
      Enabled: true
      Value: true
      Topic:
        Value: /twin/husky/uncertainty
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Marker
      Name: Telemetry connection and data age
      Enabled: true
      Value: true
      Topic:
        Value: /twin/husky/status
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Estimated route
      Enabled: true
      Value: true
      Color: 30; 230; 220
      Line Style: Lines
      Line Width: 0.08
      Topic:
        Value: /twin/husky/path
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: Husky camera (received)
      Enabled: true
      Value: true
      Normalize Range: true
      Topic:
        Value: /twin/husky/image
        Depth: 2
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point:
        X: -12
        Y: -38
        Z: 0
      Pitch: 0.75
      Yaw: 0.9
      Near Clip Distance: 0.01
      Target Frame: estate
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Estate overview
        Distance: 220
        Focal Point: {X: 0, Y: 0, Z: 0}
        Pitch: 0.85
        Yaw: 0.9
        Target Frame: estate
Window Geometry:
  Width: 1400
  Height: 950
  X: 80
  Y: 40
