<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="fleetscope_player">
    <!-- Cylinder is 0.3 radius x 1.3 m tall, origin at its center.
         Spawn so it drops a few cm onto the ground. -->
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>70</mass>
        <inertia>
          <ixx>11.4</ixx>
          <iyy>11.4</iyy>
          <izz>3.2</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <!-- Cylinder, not capsule: DART's ODE collision detector does not
             support capsule and aborts in dCollide. -->
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.3</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.32 0.72 1</ambient>
          <diffuse>0.12 0.32 0.72 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Head carries the first-person camera and pitches about the Y axis. -->
    <link name="head">
      <pose>0 0 0.55 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="head_visual">
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.85 0.65 0.5 1</ambient>
          <diffuse>0.85 0.65 0.5 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <sensor name="head_camera" type="camera">
        <pose>0.1 0 0.05 0 0 0</pose>
        <topic>/player/camera/image</topic>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>400</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="head_pitch" type="revolute">
      <parent>body</parent>
      <child>head</child>
      <pose>0 0 0.55 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.25</lower>
          <upper>1.25</upper>
          <effort>2</effort>
          <velocity>6</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="PlayerController" name="fleetscope::PlayerController">
      <link_name>body</link_name>
      <topic>/model/fleetscope_player/cmd_vel</topic>
      <jump_speed>4.0</jump_speed>
      <max_speed>7.0</max_speed>
      <max_yaw_rate>8.0</max_yaw_rate>
    </plugin>

    <plugin filename="libignition-gazebo-joint-position-controller-system.so"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>head_pitch</joint_name>
      <!-- Explicit topic: the default would be .../head_pitch/0/cmd_pos,
           whose all-numeric token is an invalid ROS 2 topic name, so the
           ros_gz_bridge could not subscribe to it. -->
      <topic>/player/head_pitch/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>1</d_gain>
    </plugin>
  </model>
</sdf>
